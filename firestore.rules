rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 누구나 사이트에서 계정을 만들 수 있지만, 관리자(gihong)가 승인하고
    // 메뉴를 열어 준 사람만 그 메뉴의 데이터를 보고 고칠 수 있어요.
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'gihong@gihong-pag.com'; }
    function meDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function can(key) {
      return isAdmin() || (signedIn() && exists(meDoc())
        && get(meDoc()).data.status == 'approved'
        && get(meDoc()).data.get('access', {}).get(key, false) == true);
    }

    // 사용자 목록: 본인은 자기 것만 읽고, 처음 한 번 '승인 대기'로만 만들 수 있어요. 승인·권한은 관리자만 바꿔요.
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'email', 'name', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email);
      // 본인은 자기 이름만 바꿀 수 있어요.
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if isAdmin();
    }

    // 할 일 목록: 문서 이름이 메뉴 key예요(common, work-gihong, work-jiyeon, gihong, jiyeon, wedding-*). 기홍 목록만 예전 이름 'tree'를 써요.
    match /shared/home/lists/{list} {
      allow read, write: if can(list) || (list == 'tree' && can('gihong'));
    }
    // 관심 뉴스 키워드 이름 목록: 뉴스를 모으는 GitHub 작업이 로그인 없이 읽어요. 쓰기는 주식 메뉴 권한이 있어야 해요.
    match /public/stocks {
      allow read: if true;
      allow write: if can('stocks');
    }
    // 구글 캘린더 일정: 관리자 기기가 구글에서 가져와 목록별(common, work-gihong, work-jiyeon, gihong, jiyeon)로 넣어 둬요.
    // 그 목록을 볼 수 있는 사람만 읽고, 쓰기와 설정(config)은 관리자만 해요.
    match /shared/home/gcal/{list} {
      allow read: if can(list);
      allow write: if isAdmin();
    }
    // 사이트 → 구글 캘린더 추가 요청: 그 목록 권한이 있는 사람이 남기면, 맥 서버가 구글에 만들고 지워요.
    match /shared/home/gcalq/{id} {
      allow create: if signedIn() && can(request.resource.data.list)
        && request.resource.data.keys().hasOnly(['list', 'calendarId', 'title', 'date', 'time', 'by', 'at'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && request.resource.data.calendarId is string
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('time' in request.resource.data) || (request.resource.data.time is string && request.resource.data.time.matches('^[0-9]{2}:[0-9]{2}$')))
        && request.resource.data.by == request.auth.uid;
      // 보낸 사람은 자기 요청(실패 여부)을 볼 수 있어요.
      allow read: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid);
    }
    // 대출계산기(loan), 결혼 비용(wedding-cost), 자산관리(asset-status, asset-ledger, asset-goals), 신혼 가전(appliances)
    match /shared/home/pages/{page} {
      allow read, write: if can(page);
    }
  }
}
